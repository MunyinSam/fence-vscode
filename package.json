{
  "name": "fence",
  "displayName": "Fence",
  "description": "A skill-aware code assistant that gates AI generation to your current understanding",
  "version": "2.0.0",
  "publisher": "MunyinSam",
  "repository": {
    "type": "git",
    "url": "https://github.com/MunyinSam/fence-vscode"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onChatParticipant:fence"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "MunyinSam.fence",
        "name": "fence",
        "description": "Generates code within your current skill level and updates your skill model over time",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  }
}
